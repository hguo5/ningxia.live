---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Cover from './Cover.astro';
import { view, type SiteEvent } from '../lib/events';
import { t as T, lp, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  event: SiteEvent;
  newer: SiteEvent | null;
  older: SiteEvent | null;
}

const { lang, event: e, newer, older } = Astro.props;
const s = T[lang];
const v = view(e, lang);
const { Content } = e;
const landscape = e.coverShape === 'landscape';
const evUrl = (slug: string) => lp(lang, `/events/${slug}/`);
// English page: use the English summary if there is one, otherwise show the Chinese text.
const enParas = lang === 'en' && e.summaryEn ? e.summaryEn.split(/\n\s*\n/) : null;
---
<Base lang={lang} path={`/events/${e.slug}/`} title={`${v.code} ${v.title}`} description={`${v.code} ${v.title} · ${v.date} · ${v.place}`} image={e.cover}>
  <section class={`wrap head ${landscape ? 'head-wide' : ''}`}>
    <div class="cover-col"><Cover event={e} lang={lang} class={landscape ? 'wide' : 'tall'} eager /></div>
    <div class="info">
      <a href={`${lp(lang, '/')}#past`} class="back">{s.backToPast}</a>
      <span class={`badge ${e.upcoming ? 'badge-next' : ''}`}>{v.code} · {e.upcoming ? s.upcomingBadge : s.pastBadge}</span>
      <h1 class="display">{v.title}</h1>
      {v.subtitle && <p class="subtitle">{v.subtitle}</p>}

      <dl>
        <dt>{s.when}</dt><dd>{v.date}{v.time && ` ${v.time}`}</dd>
        <dt>{s.where}</dt>
        <dd>{v.place}{e.backyard && <span class="note">{s.addressNote}</span>}</dd>
        {v.price && <><dt>{s.cost}</dt><dd>{v.price}</dd></>}
        {e.signup && <><dt>{s.signup}</dt><dd>{e.signupUrl ? <a href={u(e.signupUrl)}>{e.signup}</a> : e.signup}</dd></>}
      </dl>

      {enParas ? (
        <div class="body">{enParas.map((p) => <p>{p}</p>)}</div>
      ) : (
        e.hasBody && <div class="body" lang="zh-CN"><Content /></div>
      )}
    </div>
  </section>

  {!e.upcoming && (
    <section class="band">
      <div class="wrap">
        <div class="section-head">
          <h2 class="display">{s.photos}</h2>
          {e.album && <a href={u(e.album)}>{s.fullAlbum}</a>}
        </div>
        {e.photos && e.photos.length > 0 ? (
          <ul class="photos">
            {e.photos.map((p, i) => <li><img src={u(p)} alt={`${v.code} ${s.photoWord} ${i + 1}`} loading="lazy" /></li>)}
          </ul>
        ) : (
          <p class="no-photos">{s.photosSoonLong}</p>
        )}
      </div>
    </section>
  )}

  {((e.videos && e.videos.length > 0) || (e.performers && e.performers.length > 0)) && (
    <section class="wrap media">
      {e.videos && e.videos.length > 0 && (
        <div class="videos">
          <h2 class="display">{s.highlights}</h2>
          {e.videos.map((id) => (
            <div class="video">
              <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title={`${v.code} ${s.videoWord}`} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
            </div>
          ))}
        </div>
      )}
      {e.performers && e.performers.length > 0 && (
        <div class="performers">
          <h2 class="display">{s.performers}</h2>
          <ol>{e.performers.map((p) => <li>{p}</li>)}</ol>
        </div>
      )}
    </section>
  )}

  <nav class="wrap prevnext" aria-label={s.prevNextAria}>
    {older ? (
      <a href={evUrl(older.slug)} class="pn">
        <span class="pn-label">{s.prev} · {view(older, lang).code}</span>
        <span class="pn-title">{view(older, lang).title}</span>
      </a>
    ) : <span></span>}
    {newer ? (
      <a href={evUrl(newer.slug)} class="pn pn-next">
        <span class="pn-label">{s.next} · {view(newer, lang).code} →</span>
        <span class="pn-title">{view(newer, lang).title}</span>
      </a>
    ) : (
      <a href={`${lp(lang, '/')}#join`} class="pn pn-next">
        <span class="pn-label">{s.next} →</span>
        <span class="pn-title">{s.nextSoon}</span>
      </a>
    )}
  </nav>
</Base>

<style>
  .head { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; padding-top: 24px; padding-bottom: 72px; }
  .cover-col { flex: 0 1 420px; }
  .head-wide { flex-direction: column; gap: 40px; }
  .head-wide .cover-col { flex: none; width: 100%; }
  .cover-col :global(.tall) { box-shadow: 0 24px 48px rgba(31, 42, 28, 0.22); border-radius: 16px; }
  .cover-col :global(.wide) { aspect-ratio: 16 / 9; border-radius: 20px; }
  .info { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .back { font-size: 15px; text-decoration: none; }
  .badge { align-self: flex-start; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; color: var(--ground); background: var(--soft); padding: 6px 12px; border-radius: 999px; }
  .badge-next { background: var(--orange); }
  h1 { margin: 0; font-size: clamp(40px, 6vw, 60px); line-height: 1.15; color: var(--green); }
  .subtitle { margin: -8px 0 0; font-size: 18px; font-weight: 700; letter-spacing: 0.04em; color: var(--orange); }
  dl { margin: 0; display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 12px 16px; font-size: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px 0; }
  dt { color: var(--soft); }
  dd { margin: 0; font-weight: 700; }
  .note { font-weight: 400; font-size: 15px; color: var(--soft); }
  .body :global(p) { margin: 0 0 12px; font-size: 18px; line-height: 1.8; color: var(--muted); }

  .band { background: var(--paper); padding: 72px 0; }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 28px; }
  .section-head h2, .media h2 { margin: 0; font-size: clamp(36px, 5vw, 44px); color: var(--green); }
  .photos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .photos img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; }
  .no-photos { margin: 0; padding: 40px 24px; border: 2px dashed var(--line); border-radius: 14px; text-align: center; font-size: 17px; color: var(--soft); }

  .media { display: flex; flex-wrap: wrap; gap: 48px; padding-top: 72px; padding-bottom: 72px; }
  .videos { flex: 2 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .video { aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: var(--ink); }
  .video iframe { width: 100%; height: 100%; border: 0; }
  .performers { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .performers ol { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; font-size: 17px; }

  .prevnext { display: flex; flex-wrap: wrap; gap: 20px; margin: 72px auto 80px; }
  .pn { flex: 1 1 320px; text-decoration: none; color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 24px 28px; display: flex; flex-direction: column; gap: 6px; }
  .pn:hover { color: var(--ink); border-color: var(--green); }
  .pn-next { background: var(--lemon); border-color: var(--lemon); text-align: right; }
  .pn-label { font-size: 14px; color: var(--soft); }
  .pn-next .pn-label { color: #3a3a1c; }
  .pn-title { font-size: 20px; font-weight: 700; }
</style>
