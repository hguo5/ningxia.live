---
import { u } from '../lib/url';
import { view, type SiteEvent } from '../lib/events';
import { t, type Lang } from '../i18n';

interface Props {
  event: SiteEvent;
  lang: Lang;
  class?: string;
  eager?: boolean;
}

const { event, lang, class: cls = '', eager = false } = Astro.props;
const v = view(event, lang);
const alt = `${v.code} ${v.title} ${event.coverShape === 'landscape' ? t[lang].photoWord : t[lang].posterWord}`;
---
{event.cover ? (
  <img src={u(event.cover)} alt={alt} class={`cover ${cls}`} loading={eager ? 'eager' : 'lazy'} />
) : (
  <div class={`cover cover-fallback ${cls}`} role="img" aria-label={`${v.code} ${v.title}`}>
    <span class="display">{v.title}</span>
    <span class="cover-code">{v.code}</span>
  </div>
)}

<style>
  .cover { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 14px; }
  .cover-fallback {
    background: var(--lemon); color: var(--green);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    padding: 24px; text-align: center;
  }
  .cover-fallback .display { font-size: clamp(32px, 4vw, 44px); line-height: 1.2; }
  .cover-code { font-size: 14px; font-weight: 700; letter-spacing: 0.08em; }
</style>
