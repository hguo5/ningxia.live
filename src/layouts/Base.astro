---
import { u, abs } from '../lib/url';
import { site } from '../site.config';
import { t as T, lp, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string; // language-neutral path of this page, e.g. "/" or "/events/09/"
  title?: string;
  description?: string;
  image?: string;
}

const { lang, path, title, description, image = '/img/brand-poster.jpg' } = Astro.props;
const s = T[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const fullTitle = title ? `${title} · ${s.siteName}` : s.homeTitle;
const desc = description ?? s.description;
const home = lp(lang, '/');
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <link rel="canonical" href={new URL(lp(lang, path), import.meta.env.SITE).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(lp('zh', path), import.meta.env.SITE).href} />
    <link rel="alternate" hreflang="en" href={new URL(lp('en', path), import.meta.env.SITE).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(lp('zh', path), import.meta.env.SITE).href} />
    <link rel="icon" href={u('/img/logo.png')} />
    <link rel="alternate" type="text/calendar" title={s.subscribeCal} href={u('/calendar.ics')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=ZCOOL+KuaiLe&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="wrap nav">
      <div class="brand-wrap">
        <a href={home} class="brand" aria-label={`${s.siteName} ${s.nav.home}`}>
          <img src={u('/img/logo.png')} alt={`${s.siteName} Live Music & Karaoke`} width="120" height="46" />
        </a>
        <a href={site.golive.url} class="parent">
          <span class="parent-zh">{lang === 'zh' ? s.parentZh : s.parentEn}</span>
          <span class="parent-en">{lang === 'zh' ? s.parentEn : s.parentZh}</span>
        </a>
      </div>
      <nav aria-label={s.mainNav}>
        <a href={`${home}#next`}>{s.nav.next}</a>
        <a href={`${home}#past`}>{s.nav.past}</a>
        <a href={`${home}#about`}>{s.nav.about}</a>
        <a href={`${home}#support`}>{s.nav.support}</a>
        <a href={`${home}#join`} class="pill">{s.nav.join}</a>
        <a href={lp(other, path)} class="lang" hreflang={T[other].htmlLang} lang={T[other].htmlLang} aria-label={s.switchAria}>{s.switchLabel}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <p>{s.footerPre}<a href={site.golive.url}>{s.footerGoLive}</a>{s.footerPost}</p>
      <p>{s.contact}: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>{s.footer2} · <a href={site.golive.url}>golive.music</a>{site.golive.donateUrl && <> · <a href={site.golive.donateUrl}>{s.donate}</a></>}</p>
    </footer>

    <style is:global>
      :root {
        --ground: #fbf6e8;
        --paper: #ffffff;
        --ink: #1f2a1c;
        --muted: #4a5246;
        --soft: #5a6155;
        --line: #e3d9bd;
        --green: #2e5b2b;
        --green-dark: #1c3d1a;
        --green-tint: #d8e3cf;
        --lemon: #f2c230;
        --orange: #b4500f;
        --sand: #ede4cc;
        --display: 'ZCOOL KuaiLe', 'Noto Sans SC', sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: 'Noto Sans SC', system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; display: block; }
      a { color: var(--green); }
      a:hover { color: var(--green-dark); }
      .wrap { max-width: 1200px; margin: 0 auto; padding-inline: 24px; }
      .display { font-family: var(--display); font-weight: 400; }
      .eyebrow { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: 0.12em; color: var(--orange); }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
        padding: 12px 22px; border-radius: 999px; font-weight: 700; font-size: 16px; text-decoration: none;
        border: 2px solid transparent;
      }
      .btn-green { background: var(--green); color: var(--ground); }
      .btn-green:hover { background: var(--green-dark); color: var(--ground); }
      .btn-lemon { background: var(--lemon); color: var(--ink); }
      .btn-lemon:hover { background: #e0b11f; color: var(--ink); }
      .btn-dark { background: var(--ink); color: var(--ground); }
      .btn-dark:hover { background: #000; color: var(--ground); }
      .btn-white { background: #fff; color: var(--ink); }
      .btn-outline { border-color: var(--green); color: var(--green); }

      .nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
      .nav .brand img { height: 46px; width: auto; }
      .nav nav { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-weight: 500; }
      .nav nav a { color: var(--ink); text-decoration: none; }
      .nav nav a:hover { color: var(--green); }
      .nav nav a.pill { background: var(--green); color: var(--ground); padding: 10px 20px; border-radius: 999px; }
      @media (max-width: 560px) {
        .nav nav { gap: 8px 18px; font-size: 15px; }
      }

      .footer { border-top: 1px solid var(--line); padding: 28px 24px; text-align: center; font-size: 14px; color: var(--soft); }
      .footer p { margin: 0; }
      .footer p + p { margin-top: 6px; }
      .brand-wrap { display: flex; align-items: center; gap: 14px; }
      .parent {
        display: flex; flex-direction: column; line-height: 1.3; text-decoration: none;
        padding-left: 14px; border-left: 1px solid var(--line); color: var(--soft);
      }
      .parent:hover { color: var(--green); }
      .parent-zh { font-size: 13px; font-weight: 700; }
      .parent-en { font-size: 11px; letter-spacing: 0.02em; }
      .nav nav a.lang { border: 1.5px solid var(--green); color: var(--green); padding: 8px 14px; border-radius: 999px; font-weight: 700; font-size: 14px; }
      .nav nav a.lang:hover { background: var(--green); color: var(--ground); }
      html[lang="en"] .display { letter-spacing: 0.01em; }
    </style>
  </body>
</html>
